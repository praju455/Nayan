# Keep this file secret-free. Put the real key in server/.env (which must stay untracked).
# Set only providers for which you have a real key. Nayan tries the next one
# only when the current provider fails to produce a valid action.
# NAYAN_REASONING_BACKENDS=gemini,groq
# GEMINI_API_KEY=replace_with_your_gemini_key
# NAYAN_GEMINI_MODEL=gemini-3.7-flash
# GROQ_API_KEY=replace_with_your_groq_key
# NAYAN_GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=replace_with_your_openai_key
# NAYAN_OPENAI_MODEL=gpt-5
