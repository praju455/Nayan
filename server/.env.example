# Offline deterministic planner (default)
NAYAN_REASONING_BACKEND=rule

# Connected planner: Groq serving an open-weight model.
# Record the model source, version, and licence in the demo notes.
# NAYAN_REASONING_BACKEND=groq
# GROQ_API_KEY=
# NAYAN_GROQ_MODEL=llama-3.3-70b-versatile

# Sovereign mode: an installed open-weight Ollama model on localhost/private IP.
# NAYAN_REASONING_BACKEND=ollama
# NAYAN_OLLAMA_BASE_URL=http://127.0.0.1:11434
# NAYAN_OLLAMA_MODEL=
